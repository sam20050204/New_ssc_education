# ==================== CRITICAL: NEVER COMMIT ====================

# Database files (NEVER commit production data)
*.sqlite3
*.sqlite
*.db
db.sqlite3
database_backup*.db
database_backup/
*.dump
*.sql

# Backup files and directories
backup/
backups/
backup_db.bat
*.bak
*.backup
*.tmp
*.tar
*.tar.gz
*.zip

# Environment variables (NEVER commit - contains secrets!)
.env
.env.local
.env.*.local
.env.production
.env.development

# Secret keys and credentials
secret_key.txt
credentials.json
*.pem
*.key
*.crt
*.cert
*.pfx

# API keys and tokens
api_keys.txt
tokens.txt
.tokens

